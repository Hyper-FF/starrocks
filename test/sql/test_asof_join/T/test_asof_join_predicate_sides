-- name: test_asof_join_predicate_sides

-- JoinHelper.isValidAsofTemporalPredicate requires each operand of the temporal inequality
-- to resolve entirely to one side of the join, and the two operands to opposite sides. The
-- analyzer used to check only the operand types, so a predicate it accepted could still
-- leave the optimizer with zero temporal candidates -- and that escaped as
--   IllegalStateException: ASOF JOIN requires exactly one temporal inequality condition. found: 0
-- from JoinHelper.extractAndValidateAsofTemporalPredicate, which is an internal error for
-- what is really a rejected query.
--
-- These cases pin down which shapes are accepted and which are refused, so a predicate that
-- passes analysis but not the optimizer cannot go unnoticed again.

DROP DATABASE IF EXISTS test_asof_join_predicate_sides;
CREATE DATABASE test_asof_join_predicate_sides;
use test_asof_join_predicate_sides;

CREATE TABLE l (
  `k` int(11) NOT NULL,
  `t` datetime NOT NULL,
  `n` int(11) NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`k`)
DISTRIBUTED BY HASH(`k`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

CREATE TABLE r (
  `k` int(11) NOT NULL,
  `t` datetime NOT NULL,
  `v` int(11) NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`k`)
DISTRIBUTED BY HASH(`k`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

INSERT INTO l VALUES (1, '2026-01-01 10:00:00', 1), (2, '2026-01-02 10:00:00', 2);
INSERT INTO r VALUES (1, '2026-01-01 09:00:00', 100), (1, '2026-01-01 11:00:00', 200),
                     (2, '2026-01-02 09:00:00', 300);

-- Control: a plain temporal inequality, one column per side. This is the supported shape.
SELECT l.k, l.t, r.v FROM l ASOF INNER JOIN r ON l.k = r.k AND l.t >= r.t ORDER BY l.k;

-- An operand built from both sides. Each side alone cannot evaluate `date_add(r.t, l.n)`,
-- so there is no temporal candidate the optimizer can use.
SELECT l.k, r.v FROM l ASOF INNER JOIN r ON l.k = r.k AND l.t >= date_add(r.t, INTERVAL l.n DAY) ORDER BY l.k;

-- The same mixing on the left operand.
SELECT l.k, r.v FROM l ASOF INNER JOIN r ON l.k = r.k AND date_add(l.t, INTERVAL r.v SECOND) >= r.t ORDER BY l.k;

-- Both operands resolve to the SAME side, so there is no cross-side comparison to drive ASOF.
SELECT l.k, r.v FROM l ASOF INNER JOIN r ON l.k = r.k AND l.t >= date_add(l.t, INTERVAL 1 DAY) ORDER BY l.k;

-- An expression per side is fine as long as each stays on its own side.
SELECT l.k, r.v FROM l ASOF INNER JOIN r ON l.k = r.k AND date_add(l.t, INTERVAL 1 DAY) >= date_add(r.t, INTERVAL 2 HOUR) ORDER BY l.k;
