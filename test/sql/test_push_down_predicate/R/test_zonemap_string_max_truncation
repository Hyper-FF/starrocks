CREATE DATABASE IF NOT EXISTS test_zonemap_string_max_truncation_db;
-- result:
-- !result
USE test_zonemap_string_max_truncation_db;
-- result:
-- !result
CREATE TABLE zm_v (
  id INT,
  v VARCHAR(64)
) ENGINE=OLAP
DUPLICATE KEY(id)
DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
