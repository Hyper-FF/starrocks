-- name: test_recursive_cte_shapes

-- test_recursive_cte carries 238 lines and not one WITH RECURSIVE statement, so the
-- recursive path had no SQL coverage at all. That matters here because RecursiveCTEExecutor
-- rewrites the AST in place -- it clears and refills SelectRelation's CTE list while
-- iterating it and recursing into nested selects -- and a ConcurrentModificationException
-- was observed from AstTraverser.visitSelect on the fuzz cluster.
--
-- These are the shapes where the same SelectRelation can be reached more than once during
-- that rewrite: recursive and non-recursive CTEs side by side, several recursive CTEs, a
-- recursive CTE referenced twice, and one nested inside a derived table.
--
-- enable_recursive_cte defaults to false, and with it off every statement below is refused
-- in RelationTransformer.visitCTE before the executor ever runs -- which is why a test that
-- forgets to set it exercises nothing.

DROP DATABASE IF EXISTS test_recursive_cte_shapes;
CREATE DATABASE test_recursive_cte_shapes;
use test_recursive_cte_shapes;

CREATE TABLE t (
  `id` int(11) NOT NULL,
  `pid` int(11) NOT NULL
) ENGINE=OLAP
DUPLICATE KEY(`id`)
DISTRIBUTED BY HASH(`id`) BUCKETS 1
PROPERTIES ("replication_num" = "1");

INSERT INTO t VALUES (1, 0), (2, 1), (3, 2), (4, 3);

set enable_recursive_cte = true;

-- Control: the plain recursive walk.
WITH RECURSIVE r AS (
  SELECT id, pid FROM t WHERE pid = 0
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN r ON t.pid = r.id
)
SELECT count(*) FROM r;

-- A recursive and a non-recursive CTE in the same WITH clause: the executor keeps the
-- non-recursive one and drops the recursive one from the list it is iterating.
WITH RECURSIVE r AS (
  SELECT id, pid FROM t WHERE pid = 0
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN r ON t.pid = r.id
), n AS (
  SELECT id FROM t
)
SELECT count(*) FROM r JOIN n ON r.id = n.id;

-- Two recursive CTEs, so the rewrite runs twice over the same list.
WITH RECURSIVE a AS (
  SELECT id, pid FROM t WHERE pid = 0
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN a ON t.pid = a.id
), b AS (
  SELECT id, pid FROM t WHERE pid = 1
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN b ON t.pid = b.id
)
SELECT (SELECT count(*) FROM a) + (SELECT count(*) FROM b);

-- The same recursive CTE referenced from two places.
WITH RECURSIVE r AS (
  SELECT id, pid FROM t WHERE pid = 0
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN r ON t.pid = r.id
)
SELECT (SELECT count(*) FROM r) + (SELECT count(*) FROM r);

-- A recursive CTE inside a derived table, so the rewrite happens under an outer select.
SELECT * FROM (
  WITH RECURSIVE r AS (
    SELECT id, pid FROM t WHERE pid = 0
    UNION ALL
    SELECT t.id, t.pid FROM t JOIN r ON t.pid = r.id
  )
  SELECT count(*) AS c FROM r
) x;

-- With the feature off, the same statement must be refused rather than planned.
set enable_recursive_cte = false;
WITH RECURSIVE r AS (
  SELECT id, pid FROM t WHERE pid = 0
  UNION ALL
  SELECT t.id, t.pid FROM t JOIN r ON t.pid = r.id
)
SELECT count(*) FROM r;
