-- name: test_scan_close_before_task_start @sequential
-- description: Verify the close-before-start race in ScanOperator. When a queued scan IO task
-- starts after its chunk source slot was already closed, the operator must still run the
-- IO-task finalization bookkeeping (decrement _num_running_io_tasks, clear _is_io_task_running,
-- notify) so the query completes cleanly instead of hanging. The race is forced deterministically
-- via the 'scan_close_source_before_task_start' fail point: every queued IO task closes its own
-- chunk source slot right before it would start running.
create database db_${uuid0};
-- result:
-- !result
use db_${uuid0};
-- result:
-- !result
CREATE TABLE t1 (
    k1 INT,
    v1 INT
) DUPLICATE KEY(k1)
DISTRIBUTED BY HASH(k1) BUCKETS 8
PROPERTIES('replication_num' = '1');
-- result:
-- !result
insert into t1 select generate_series, generate_series from TABLE(generate_series(1, 5000));
-- result:
-- !result
select count(*) from t1;
-- result:
5000
-- !result
admin enable failpoint 'scan_close_source_before_task_start';
-- result:
-- !result
[UC] select count(*) from t1;
-- result:
-- !result
[UC] select * from t1 order by k1 limit 10;
-- result:
-- !result
[UC] select sum(v1) from t1;
-- result:
-- !result
admin disable failpoint 'scan_close_source_before_task_start';
-- result:
-- !result
select count(*) from t1;
-- result:
5000
-- !result
select sum(v1) from t1;
-- result:
12502500
-- !result
