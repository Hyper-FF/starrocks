-- name: test_json_nested_partial_append
--
-- Repro for the JSON nested-type partial-append bug in
-- be/src/formats/json/nullable_column.cpp.
--
-- ROOT CAUSE
--   add_adaptive_nullable_array_column iterates the JSON array and appends
--   each element into the inner elements_column. The offsets / null_column
--   for the outer ArrayColumn are updated ONLY AFTER the loop completes
--   cleanly. If simdjson throws mid-iteration (e.g. on malformed JSON like
--   `[1 2 3]` with missing commas), the function's try-catch swallows the
--   exception and returns DataQualityError, but the partial appends to
--   elements_column are NEVER rolled back.
--
--   The outer add_adaptive_nullable_column wrapper (called with
--   invalid_as_null=true because strict_mode is off by default) then sees
--   the DataQualityError and calls column->append_nulls(1) to "recover".
--   That advances null_column +1 and offsets +1 (zero-length array), but
--   does NOT touch elements_column.  The leaked elements stay as
--   "phantom" rows in elements_column.
--
--   The next successfully-parsed row's offset arithmetic is
--      sz = offsets.back() + n_new_elements
--   while elements_column already has `phantom + n_new` rows past
--   offsets.back().  Reading offsets[k]..offsets[k+1] returns the PHANTOM
--   elements instead of (or in front of) the legitimate new elements.
--
-- THIS TEST'S DATA  (test/common/data/stream_load/sr_json_nested_partial_append.jsonl)
--   {"id": 1, "arr": [1 2 3]}        <-- malformed; simdjson throws on the
--                                        second element AFTER `1` has been
--                                        appended to elements_column.
--   {"id": 2, "arr": [100, 200]}     <-- well-formed.
--   {"id": 3, "arr": [300, 400, 500]} <-- well-formed.
--
-- EXPECTED, IF THE BUG IS FIXED
--   id | arr
--    1 | NULL          (malformed JSON, recovered as NULL)
--    2 | [100,200]
--    3 | [300,400,500]
--
-- ACTUAL (BUG)
--   id | arr
--    1 | NULL          (recovered as NULL - correct)
--    2 | [1,100]       (phantom `1` from row 1 leaked; should be [100,200])
--    3 | [200,300,400] (phantom `200` from row 2 corruption; should be
--                       [300,400,500])
--
-- The corruption is OFF-BY-ONE-per-row and propagates indefinitely until a
-- NULL or an array of size >= 1+phantom drains the phantoms.
create database test_json_nested_partial_append_${uuid0};
-- result:
-- !result
use test_json_nested_partial_append_${uuid0};
-- result:
-- !result
create table t_arr (
    id int NOT NULL,
    arr array<int> NULL
) DUPLICATE KEY(id) DISTRIBUTED BY HASH(id) BUCKETS 1
PROPERTIES ("replication_num" = "1");
-- result:
-- !result
-- strict_mode defaults to false  =>  invalid_as_null = true  =>  bug path.
-- max_filter_ratio = 1.0 keeps the malformed row (filtered to NULL) instead
-- of failing the whole stream-load transaction.
shell: curl --location-trusted -u root: -T ${root_path}/lib/../common/data/stream_load/sr_json_nested_partial_append.jsonl -H "format: JSON" -H "Expect: 100-continue" -H "max_filter_ratio: 1.0" -XPUT -H label:test_json_nested_partial_append_arr_${uuid0} ${url}/api/test_json_nested_partial_append_${uuid0}/t_arr/_stream_load
-- result:
0
{
    "Status": "Success",
    "Message": "OK"
}
-- !result
sync;
-- result:
-- !result
-- Assertion: row id=2 should yield [100,200] and row id=3 should yield
-- [300,400,500]. With the bug, both arrays are shifted/contaminated by
-- the phantom element(s) that row id=1 leaked into elements_column.
select id, arr, array_length(arr) as len from t_arr order by id;
-- result:
1	None	None
2	[100,200]	2
3	[300,400,500]	3
-- !result
-- Drain test: the first element of arr should be 100 for id=2 and 300 for
-- id=3. With the bug, id=2's first element is `1` (the phantom from row 1)
-- and id=3's first element is `200` (carryover phantom).
select id, arr[1] as first_elem from t_arr where id >= 2 order by id;
-- result:
2	100
3	300
-- !result
drop table t_arr;
-- result:
-- !result
drop database test_json_nested_partial_append_${uuid0};
-- result:
-- !result
