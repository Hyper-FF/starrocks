-- name: test_flat_json_int_double_precision
-- Regression for flat-JSON integer precision loss. When a key is an integer in most rows but a
-- float in >=1 row of the same segment, its flattened sub-column was typed DOUBLE (int-bits AND
-- double-bits = double); integers > 2^53 then read back with silent precision loss and distinct
-- large integers merged. Such a key is now kept as JSON so the exact value is preserved.
create table t(id int, j json) duplicate key(id)
  distributed by hash(id) buckets 1
  properties("replication_num"="1","flat_json.enable"="true");
-- result:
-- !result
